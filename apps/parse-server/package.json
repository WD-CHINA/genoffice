{
  "name": "@genoffice/parse-server",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "Standalone document parse service: content-addressed uploads, Range reads and the versioned parse contract (PPTX/PDF in v1)",
  "scripts": {
    "dev": "node --import tsx src/bin.ts",
    "start": "node --import tsx src/bin.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "backup:check": "node --import tsx scripts/backup-check.mts",
    "stress": "node --import tsx scripts/stress-smoke.mts",
    "stress:docx": "node --import tsx scripts/docx-stress.mts",
    "fixture:docx-large": "node --import tsx scripts/docx-large-fixture.mts",
    "fixture:docx-1g": "node --import tsx scripts/docx-1g-fixture.mts"
  },
  "dependencies": {
    "@genoffice/parse-contract": "*",
    "@genoffice/pptx-engine": "*",
    "@genoffice/pptx-render": "*",
    "@genoffice/zip-gate": "*",
    "@genoffice/zip-reader": "*",
    "mysql2": "^3.24.6",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@genoffice/docx-engine": "*",
    "@types/node": "^24.10.1",
    "jszip": "^3.10.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}

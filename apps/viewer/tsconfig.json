{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "vite/client"],
    "baseUrl": "../..",
    "paths": {
      "@genoffice/viewer-renderers/ui": ["packages/viewer-renderers/src/ui/index.ts"],
      "@genoffice/viewer-renderers/*": ["packages/viewer-renderers/src/*"],
      "@genoffice/viewer-services/*": ["packages/viewer-services/src/*"]
    }
  },
  "include": ["src", "tests", "vite.config.ts"]
}
